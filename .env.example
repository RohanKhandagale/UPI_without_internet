# Optional. Defaults are suitable for the local demo.
UPI_NETWORK_DB_PATH=upi_network.db
UPI_NETWORK_MAX_PACKET_AGE_SECONDS=86400
UPI_NETWORK_HOST=127.0.0.1
UPI_NETWORK_PORT=8080
# Keep this file on persistent storage so cached mobile public keys remain valid.
UPI_NETWORK_PRIVATE_KEY_PATH=data/server_private_key.pem
